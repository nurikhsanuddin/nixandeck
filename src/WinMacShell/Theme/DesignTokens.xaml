<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Typography -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Display, Segoe UI, Segoe UI Emoji, Segoe UI Symbol</FontFamily>

    <!-- Core Palette -->
    <Color x:Key="TopBarBackgroundColor">#CC14141A</Color>
    <Color x:Key="NotchBackgroundColor">#FF000000</Color>
    <Color x:Key="NotchBorderColor">#26FFFFFF</Color>
    <Color x:Key="DockBackgroundColor">#B8141418</Color>
    <Color x:Key="DockBorderColor">#33FFFFFF</Color>
    <Color x:Key="CardSurfaceColor">#FF151519</Color>
    <Color x:Key="CardBorderColor">#22FFFFFF</Color>
    <Color x:Key="HoverSurfaceColor">#22FFFFFF</Color>
    <Color x:Key="PressedSurfaceColor">#33FFFFFF</Color>
    <Color x:Key="PrimaryTextColor">#FFF4F4F5</Color>
    <Color x:Key="SecondaryTextColor">#FFA1A1AA</Color>
    <Color x:Key="AccentColor">#FF3B82F6</Color>
    <Color x:Key="SuccessColor">#FF22C55E</Color>
    <Color x:Key="WarningColor">#FFF59E0B</Color>

    <!-- Clean Translucent Glass Brushes (No heavy multi-stop gradients) -->
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="{StaticResource TopBarBackgroundColor}"/>
    <SolidColorBrush x:Key="NotchBackgroundBrush" Color="{StaticResource NotchBackgroundColor}"/>
    <SolidColorBrush x:Key="NotchBorderBrush" Color="{StaticResource NotchBorderColor}"/>
    <SolidColorBrush x:Key="DockBackgroundBrush" Color="{StaticResource DockBackgroundColor}"/>
    <SolidColorBrush x:Key="DockBorderBrush" Color="{StaticResource DockBorderColor}"/>

    <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="{StaticResource HoverSurfaceColor}"/>
    <SolidColorBrush x:Key="PressedSurfaceBrush" Color="{StaticResource PressedSurfaceColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#33FFFFFF"/>

    <!-- Shadows -->
    <DropShadowEffect x:Key="NotchShadowEffect"
                      Color="#FF000000"
                      BlurRadius="18"
                      ShadowDepth="4"
                      Direction="270"
                      Opacity="0.48"/>

    <DropShadowEffect x:Key="DockShadowEffect"
                      Color="#FF000000"
                      BlurRadius="20"
                      ShadowDepth="4"
                      Direction="270"
                      Opacity="0.45"/>
</ResourceDictionary>
