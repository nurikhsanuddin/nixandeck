<Window x:Class="WinMacShell.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinMacShell TopBar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Height="500"
        UseLayoutRounding="True">

    <Window.Resources>
        <Storyboard x:Key="VisualizerStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="VizBar1" Storyboard.TargetProperty="Height" From="4" To="13" Duration="0:0:0.35" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="VizBar2" Storyboard.TargetProperty="Height" From="12" To="5" Duration="0:0:0.28" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="VizBar3" Storyboard.TargetProperty="Height" From="6" To="14" Duration="0:0:0.42" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="VizBar4" Storyboard.TargetProperty="Height" From="12" To="4" Duration="0:0:0.31" AutoReverse="True"/>
        </Storyboard>

        <!-- Vector Icon Geometries -->
        <Geometry x:Key="IconWindows">M2,2 H9.2 V9.2 H2 Z M10.8,2 H18 V9.2 H10.8 Z M2,10.8 H9.2 V18 H2 Z M10.8,10.8 H18 V18 H10.8 Z</Geometry>
        <Geometry x:Key="IconFolder">M2,4.5 C2,3.7 2.7,3 3.5,3 H8 L10,5 H16.5 C17.3,5 18,5.7 18,6.5 V15.5 C18,16.3 17.3,17 16.5,17 H3.5 C2.7,17 2,16.3 2,15.5 Z</Geometry>
        <Geometry x:Key="IconSettings">M8.5,2.2 H11.5 L12.0,4.2 L13.5,4.8 L15.2,3.7 L17.3,5.8 L16.2,7.5 L16.8,9.0 L18.8,9.5 V12.5 L16.8,13.0 L16.2,14.5 L17.3,16.2 L15.2,18.3 L13.5,17.2 L12.0,17.8 L11.5,19.8 H8.5 L8.0,17.8 L6.5,17.2 L4.8,18.3 L2.7,16.2 L3.8,14.5 L3.2,13.0 L1.2,12.5 V9.5 L3.2,9.0 L3.8,7.5 L2.7,5.8 L4.8,3.7 L6.5,4.8 L8.0,4.2 Z M10,8.2 A2.8,2.8 0 1,1 9.99,8.2 Z</Geometry>
        <Geometry x:Key="IconTaskMgr">M2,13 H5.5 L7.5,6.5 L10.5,14.5 L12.8,9.5 L14.5,13 H18</Geometry>
        <Geometry x:Key="IconTerminal">M3,5 L8,10 L3,15 M9.5,15 H16.5</Geometry>
        <Geometry x:Key="IconPrev">M5,5 H7.2 V15 H5 Z M15,5 L8,10 L15,15 Z</Geometry>
        <Geometry x:Key="IconPlay">M6,4 L16,10 L6,16 Z</Geometry>
        <Geometry x:Key="IconPause">M5.5,4.5 H8.5 V15.5 H5.5 Z M11.5,4.5 H14.5 V15.5 H11.5 Z</Geometry>
        <Geometry x:Key="IconNext">M5,5 L12,10 L5,15 Z M12.8,5 H15 V15 H12.8 Z</Geometry>
        <Geometry x:Key="IconWifi">M1,6 C5.5,1.8 12.5,1.8 17,6 M3.6,8.8 C6.7,5.8 11.3,5.8 14.4,8.8 M6.4,11.6 C8,10.1 10,10.1 11.6,11.6 M9,14.2 A0.9,0.9 0 1,1 8.99,14.2 Z</Geometry>
        <Geometry x:Key="IconSpeaker">M2,7.5 H5.5 L10,3.5 V16.5 L5.5,12.5 H2 Z M13,6.8 C14.5,8.3 14.5,11.7 13,13.2 M15.2,4.8 C17.8,7.4 17.8,12.6 15.2,15.2</Geometry>
        <Geometry x:Key="IconSpeakerMuted">M2,7.5 H5.5 L10,3.5 V16.5 L5.5,12.5 H2 Z M13,7 L17.5,13 M17.5,7 L13,13</Geometry>
        <Geometry x:Key="IconSun">M10,6.5 A3.5,3.5 0 1,1 9.99,6.5 Z M10,1.5 V3.5 M10,16.5 V18.5 M1.5,10 H3.5 M16.5,10 H18.5 M4,4 L5.4,5.4 M14.6,14.6 L16,16 M16,4 L14.6,5.4 M5.4,14.6 L4,16</Geometry>
        <Geometry x:Key="IconBluetooth">M6,5.5 L14,13.5 L10,17.5 V2.5 L14,6.5 L6,14.5</Geometry>
        <Geometry x:Key="IconMoon">M12.5,3 C8.8,3.6 6.2,7.1 6.9,10.9 C7.5,14.1 10.3,16.4 13.5,16.4 C14.7,16.4 15.8,16.0 16.8,15.3 C15.4,17.3 13.0,18.4 10.4,18.2 C6.0,17.9 2.6,14.1 2.9,9.6 C3.2,5.6 6.3,2.4 10.3,2.1 C11.1,2.0 11.9,2.4 12.5,3 Z</Geometry>
        <Geometry x:Key="IconProject">M2,4.5 H12 V12.5 H2 Z M8,8 H18 V16 H8 Z</Geometry>
        <Geometry x:Key="IconSnip">M4,4 H14 V14 H4 Z M2,7 H6 M14,13 H18 M12,2 V6 M8,14 V18</Geometry>
        <Geometry x:Key="IconBattery">M2,5.5 H15 V14.5 H2 Z M15.5,8 H17.5 V12 H15.5 Z</Geometry>
        <Geometry x:Key="IconBell">M10,2.5 A4.5,4.5 0 0,1 14.5,7 V11.5 L16.5,14 V15 H3.5 V14 L5.5,11.5 V7 A4.5,4.5 0 0,1 10,2.5 Z M8.2,16.5 A2,2 0 0,0 11.8,16.5</Geometry>
        <Geometry x:Key="IconMusicNote">M8,14.5 A2.2,2.2 0 1,1 5.8,12.3 C6.6,12.3 7.3,12.7 7.6,13.3 V4.8 L15,3.2 V12.5 A2.2,2.2 0 1,1 12.8,10.3 C13.6,10.3 14.3,10.7 14.6,11.3 V6.3 L9,7.5 V14.5 Z</Geometry>
        <Geometry x:Key="IconCalendar">M3.5,4.5 H16.5 V16.5 H3.5 Z M3.5,8 H16.5 M6.5,2.5 V5.5 M13.5,2.5 V5.5</Geometry>
        <Geometry x:Key="IconMirror">M10,3.5 A4,4 0 1,1 9.99,3.5 Z M10,6.2 A1.3,1.3 0 1,1 9.99,6.2 Z M7.5,13.5 L10,11.5 L12.5,13.5 M5.5,16.2 H14.5</Geometry>
        <Geometry x:Key="IconTray">M3,11 H6.5 L8,13.5 H12 L13.5,11 H17 V16.5 H3 Z M4.5,5.5 H15.5 L17,11 H3 Z</Geometry>
        <Geometry x:Key="IconSparkle">M10,2 L11.8,7.2 L17,9 L11.8,10.8 L10,16 L8.2,10.8 L3,9 L8.2,7.2 Z</Geometry>
        <Geometry x:Key="IconChevronLeft">M12,4 L6,10 L12,16</Geometry>
        <Geometry x:Key="IconChevronRight">M8,4 L14,10 L8,16</Geometry>
        <Geometry x:Key="IconChevronDown">M4.5,7.5 L10,13 L15.5,7.5</Geometry>
        <Geometry x:Key="IconChevronUp">M4.5,12.5 L10,7 L15.5,12.5</Geometry>
        <Geometry x:Key="IconClose">M5,5 L15,15 M15,5 L5,15</Geometry>
        <Geometry x:Key="IconWifiOuter">M1,6 C5.5,1.8 12.5,1.8 17,6</Geometry>
        <Geometry x:Key="IconWifiMid">M3.6,8.8 C6.7,5.8 11.3,5.8 14.4,8.8</Geometry>
        <Geometry x:Key="IconWifiInner">M6.4,11.6 C8,10.1 10,10.1 11.6,11.6 M9,14.2 A0.9,0.9 0 1,1 8.99,14.2 Z</Geometry>
        <Geometry x:Key="IconWifiOffline">M1,6 C5.5,1.8 12.5,1.8 17,6 M3.6,8.8 C6.7,5.8 11.3,5.8 14.4,8.8 M6.4,11.6 C8,10.1 10,10.1 11.6,11.6 M3,3 L15,15</Geometry>
        <Geometry x:Key="IconEthernet">M3,4.5 H9 V8.5 H3 Z M11,11.5 H17 V15.5 H11 Z M6,8.5 V13.5 H11 M14,11.5 V6.5 H9</Geometry>
        <Geometry x:Key="IconHotspot">M5,6.5 A6.5,6.5 0 0,1 15,6.5 M7.2,9 A3.5,3.5 0 0,1 12.8,9 M10,11.5 A1.2,1.2 0 1,1 9.99,11.5 Z M10,12.7 V17</Geometry>
        <Geometry x:Key="IconLock">M5,9.5 H15 V16.5 H5 Z M7,9.5 V6.8 A3,3 0 0,1 13,6.8 V9.5</Geometry>
    </Window.Resources>

    <Grid Background="{x:Null}">
        <!-- 1. FULL-WIDTH APPLE-STYLE TOP MENU BAR (30px height) -->
        <Border x:Name="TopBarBorder"
                Height="30"
                VerticalAlignment="Top"
                Background="{StaticResource TopBarBackgroundBrush}"
                BorderThickness="0"
                Padding="10,0,10,0"
                MouseRightButtonUp="TopBarBorder_RightClick">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Windows Start Button + nixandeck Indicator + Quick System Shortcuts -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="WindowsStartButton"
                            Style="{StaticResource ShellIconButtonStyle}"
                            Height="24"
                            Padding="6,4"
                            ToolTip="Start Menu (Windows)"
                            PreviewMouseLeftButtonDown="WindowsStart_PreviewMouseDown"
                            Click="WindowsStart_Click"
                            MouseRightButtonUp="WindowsStart_RightClick">
                        <Path Data="{StaticResource IconWindows}"
                              Fill="{StaticResource PrimaryTextBrush}"
                              Width="13"
                              Height="13"
                              Stretch="Uniform"/>
                    </Button>

                    <TextBlock Text="Nixandeck"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="#E6FFFFFF"
                               Margin="4,0,6,0"
                               VerticalAlignment="Center"/>

                    <Border Width="1" Height="13" Background="#28FFFFFF" Margin="4,0"/>

                    <Button Style="{StaticResource ShellIconButtonStyle}"
                            Width="26"
                            Height="24"
                            Padding="5"
                            Margin="0,0,2,0"
                            ToolTip="File Explorer"
                            Click="ShortcutExplorer_Click">
                        <Path Data="{StaticResource IconFolder}"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeThickness="1.4"
                              Width="13"
                              Height="12"
                              Stretch="Uniform"/>
                    </Button>

                    <Button Style="{StaticResource ShellIconButtonStyle}"
                            Width="26"
                            Height="24"
                            Padding="5"
                            Margin="0,0,2,0"
                            ToolTip="Windows Settings"
                            Click="ShortcutSettings_Click">
                        <Path Data="{StaticResource IconSettings}"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="13"
                              Height="13"
                              Stretch="Uniform"/>
                    </Button>

                    <Button Style="{StaticResource ShellIconButtonStyle}"
                            Width="26"
                            Height="24"
                            Padding="5"
                            Margin="0,0,2,0"
                            ToolTip="Task Manager"
                            Click="ShortcutTaskManager_Click">
                        <Path Data="{StaticResource IconTaskMgr}"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="13"
                              Height="12"
                              Stretch="Uniform"/>
                    </Button>

                    <Button Style="{StaticResource ShellIconButtonStyle}"
                            Width="26"
                            Height="24"
                            Padding="5"
                            ToolTip="Windows Terminal"
                            Click="ShortcutTerminal_Click">
                        <Path Data="{StaticResource IconTerminal}"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="12"
                              Height="11"
                              Stretch="Uniform"/>
                    </Button>

                    <Border Width="1" Height="13" Background="#28FFFFFF" Margin="5,0"/>

                    <!-- CPU & RAM Usage Indicator (Left of Dynamic Island, Click: Task Manager) -->
                    <Button Style="{StaticResource ShellIconButtonStyle}"
                            Height="24"
                            Padding="6,3"
                            ToolTip="CPU &amp; RAM Usage (Click: Open Task Manager)"
                            Click="ShortcutTaskManager_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TopCpuText"
                                       Text="CPU 0%"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="#FFD4D4D8"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" · "
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="10.5"
                                       Foreground="#66FFFFFF"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TopRamText"
                                       Text="RAM 0%"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="#FFD4D4D8"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- RIGHT: System Tray Dropdown + Wi-Fi/Ethernet + Brightness + Volume + Battery + Clock/Hub -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Windows-Style System Tray Overflow Dropdown Toggle -->
                    <Button x:Name="TopTrayDropdownButton"
                            Style="{StaticResource ShellIconButtonStyle}"
                            Width="26"
                            Height="24"
                            Padding="6"
                            Click="TopTrayDropdown_Click"
                            ToolTip="Show Hidden Icons (System Tray)">
                        <Path x:Name="TopTrayChevronPath"
                              Data="{StaticResource IconChevronDown}"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="11"
                              Height="11"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>

                    <Border Width="1" Height="13" Background="#28FFFFFF" Margin="4,0"/>

                    <!-- Real-Time Interactive Wi-Fi / Ethernet Button (Dynamic Signal Bars & Connection Kind) -->
                    <Button x:Name="TopWifiButton"
                            Style="{StaticResource ShellIconButtonStyle}"
                            Width="26"
                            Height="24"
                            Padding="4.5"
                            ToolTip="Click: Network Flyout | Right-Click: Network Settings"
                            PreviewMouseLeftButtonDown="TopWifi_PreviewMouseDown"
                            Click="TopWifi_Click"
                            MouseRightButtonUp="TopWifi_RightClick">
                        <Grid Width="15" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Wi-Fi 3-Bar Signal Strength View -->
                            <Viewbox x:Name="TopWifiBarsPanel" Stretch="Uniform" Visibility="Visible">
                                <Canvas Width="18" Height="16">
                                    <Path x:Name="WifiOuterArc"
                                          Data="{StaticResource IconWifiOuter}"
                                          Stroke="{StaticResource PrimaryTextBrush}"
                                          StrokeThickness="1.55"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                    <Path x:Name="WifiMidArc"
                                          Data="{StaticResource IconWifiMid}"
                                          Stroke="{StaticResource PrimaryTextBrush}"
                                          StrokeThickness="1.55"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                    <Path x:Name="WifiInnerArc"
                                          Data="{StaticResource IconWifiInner}"
                                          Stroke="{StaticResource PrimaryTextBrush}"
                                          StrokeThickness="1.55"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>

                            <!-- Ethernet Connected View -->
                            <Path x:Name="TopEthernetIcon"
                                  Visibility="Collapsed"
                                  Data="{StaticResource IconEthernet}"
                                  Stroke="{StaticResource PrimaryTextBrush}"
                                  StrokeThickness="1.45"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="14"
                                  Height="12"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>

                            <!-- Offline View -->
                            <Path x:Name="TopWifiOfflineIcon"
                                  Visibility="Collapsed"
                                  Data="{StaticResource IconWifiOffline}"
                                  Stroke="{StaticResource WarningBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="14"
                                  Height="12"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Interactive Brightness Button (Icon Only, toggles Brightness Slider popup) -->
                    <Button x:Name="TopBrightnessButton"
                            Style="{StaticResource ShellIconButtonStyle}"
                            Width="26"
                            Height="24"
                            Padding="5"
                            Margin="2,0,0,0"
                            ToolTip="Click: Brightness Slider | Scroll: Brightness | Right-Click: Display Settings"
                            Click="TopBrightness_Click"
                            MouseRightButtonUp="TopBrightness_RightClick"
                            PreviewMouseWheel="TopBrightness_MouseWheel">
                        <Path Data="{StaticResource IconSun}"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="13"
                              Height="13"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>

                    <!-- Interactive Volume Button (toggles dedicated Volume Slider popup) -->
                    <Button x:Name="TopVolumeButton"
                            Style="{StaticResource ShellIconButtonStyle}"
                            Height="24"
                            Padding="6,3"
                            Margin="2,0,0,0"
                            ToolTip="Click: Volume Slider | Scroll: Volume | Right-Click: Mute"
                            Click="TopVolume_Click"
                            MouseRightButtonUp="TopVolume_RightClick"
                            PreviewMouseWheel="TopVolume_MouseWheel">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="TopVolumeIcon"
                                  Data="{StaticResource IconSpeaker}"
                                  Stroke="{StaticResource PrimaryTextBrush}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="13"
                                  Height="12"
                                  Stretch="Uniform"
                                  Margin="0,0,4,0"/>
                            <TextBlock x:Name="TopVolumeText"
                                       Text="50%"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Interactive Battery Button (Dynamic Fill + Charging Bolt) -->
                    <Button x:Name="TopBatteryButton"
                            Style="{StaticResource ShellIconButtonStyle}"
                            Height="24"
                            Padding="6,3"
                            Margin="2,0,0,0"
                            ToolTip="Click: Power Settings | Right-Click: Battery Options"
                            Click="TopBattery_Click"
                            MouseRightButtonUp="TopBattery_RightClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="20" Height="11" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Border x:Name="TopBatteryBodyBorder"
                                        Width="17"
                                        Height="11"
                                        HorizontalAlignment="Left"
                                        CornerRadius="2.5"
                                        BorderBrush="{StaticResource PrimaryTextBrush}"
                                        BorderThickness="1.3"
                                        Background="#18FFFFFF"
                                        Padding="1.5">
                                    <Border x:Name="TopBatteryFillBar"
                                            HorizontalAlignment="Left"
                                            Width="11"
                                            CornerRadius="1"
                                            Background="#FFFFFFFF"/>
                                </Border>
                                <Border Width="2"
                                        Height="4.5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        CornerRadius="0,1,1,0"
                                        Background="{StaticResource PrimaryTextBrush}"/>
                                <Path x:Name="TopBatteryBoltIcon"
                                      Visibility="Collapsed"
                                      Data="M 9.5,1 L 5.5,6 H 8.5 L 7.5,10 L 11.5,5 H 8.5 Z"
                                      Fill="#FF22C55E"
                                      Stroke="#FF050508"
                                      StrokeThickness="0.6"
                                      Stretch="Uniform"
                                      Width="7"
                                      Height="9"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="-1,0,0,0"/>
                            </Grid>
                            <TextBlock x:Name="TopBatteryText"
                                       Text="100%"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="13" Background="#28FFFFFF" Margin="5,0"/>

                    <!-- Clock & Calendar/Notification Flyout Toggle -->
                    <Button x:Name="ClockHubButton"
                            Style="{StaticResource ShellIconButtonStyle}"
                            Height="24"
                            Padding="8,3"
                            ToolTip="Click: Calendar &amp; Notifications"
                            Click="ToggleHub_Click">
                        <TextBlock x:Name="TopClockText"
                                   Text="Fri, 13 Nov  09:00"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. UNIFIED MORPHING DYNAMIC ISLAND (Floating capsule in MediaPill; top-attached with concave ear flares when ExpandedHub/Toast) -->
        <Border x:Name="DynamicIslandShell"
                Width="140"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Visibility="Visible"
                Cursor="Hand"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="15"
                MouseEnter="DynamicIsland_MouseEnter"
                MouseLeave="DynamicIsland_MouseLeave"
                MouseLeftButtonDown="DynamicIsland_Click">

            <Grid ClipToBounds="False">
                <!-- Outward-pulled concave top corners visible during NotificationToast & ExpandedHub -->
                <Path x:Name="LeftTopEarFlare"
                      Data="M 0,0 L 20,0 L 20,20 C 20,6.5 13.5,0 0,0 Z"
                      Fill="#FF000000"
                      Width="20"
                      Height="20"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="-19.5,0,0,0"
                      Visibility="Collapsed"
                      IsHitTestVisible="False"/>

                <Path x:Name="RightTopEarFlare"
                      Data="M 0,0 L 20,0 C 6.5,0 0,6.5 0,20 L 0,0 Z"
                      Fill="#FF000000"
                      Width="20"
                      Height="20"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,0,-19.5,0"
                      Visibility="Collapsed"
                      IsHitTestVisible="False"/>

                <Grid x:Name="IslandContentContainer" ClipToBounds="True" RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="IslandContentScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>

                    <!-- State A: Idle Pill View (Subtle horizontal hover/click indicator) -->
                    <Grid x:Name="IdleIslandView" Visibility="Visible">
                        <Border x:Name="IslandHoverBar"
                                Width="42"
                                Height="3.5"
                                CornerRadius="2"
                                Background="#88FFFFFF"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- State B: Active Media Pill View (True floating rounded Dynamic Island capsule, NO bottom gray line) -->
                    <Grid x:Name="MediaPillView" Visibility="Collapsed">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="6" Background="#22FFFFFF" ClipToBounds="True" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="♫" FontSize="10.5" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="PillAlbumArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Clip>
                                            <RectangleGeometry RadiusX="6" RadiusY="6" Rect="0,0,20,20"/>
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="PillTrackTitle"
                                       Grid.Column="1"
                                       Margin="8,0,8,0"
                                       Text="Playing..."
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="12" Margin="0,0,6,0">
                                <Border x:Name="VizBar1" Width="2.2" Height="4" CornerRadius="1.1" Background="{StaticResource AccentBrush}" Margin="1,0" VerticalAlignment="Center"/>
                                <Border x:Name="VizBar2" Width="2.2" Height="10" CornerRadius="1.1" Background="{StaticResource AccentBrush}" Margin="1,0" VerticalAlignment="Center"/>
                                <Border x:Name="VizBar3" Width="2.2" Height="6" CornerRadius="1.1" Background="{StaticResource AccentBrush}" Margin="1,0" VerticalAlignment="Center"/>
                                <Border x:Name="VizBar4" Width="2.2" Height="9" CornerRadius="1.1" Background="{StaticResource AccentBrush}" Margin="1,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="3"
                                    Style="{StaticResource ShellIconButtonStyle}"
                                    Width="20"
                                    Height="20"
                                    Padding="4"
                                    Click="PlayPauseMedia_Click"
                                    ToolTip="Play / Pause">
                                <Path x:Name="PillPlayPausePath" Data="{StaticResource IconPause}" Fill="{StaticResource PrimaryTextBrush}" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- State C: Enlarged Readable Notification Toast View (424x84, crisp emoji rendering, 2-line body) -->
                    <Grid x:Name="ToastView" Visibility="Collapsed" Margin="16,10,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="42"
                                Height="42"
                                CornerRadius="11"
                                Background="#1BFFFFFF"
                                ClipToBounds="True"
                                VerticalAlignment="Center">
                            <Grid>
                                <Path x:Name="ToastFallbackIcon"
                                      Data="{StaticResource IconBell}"
                                      Stroke="{StaticResource SecondaryTextBrush}"
                                      StrokeThickness="1.5"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                <Image x:Name="ToastAppIcon" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip>
                                        <RectangleGeometry RadiusX="11" RadiusY="11" Rect="0,0,42,42"/>
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                            <DockPanel Margin="0,0,0,1">
                                <TextBlock x:Name="ToastAppName"
                                           Text="App"
                                           FontFamily="{StaticResource AppFontFamily}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="#FFB0B8C4"/>
                                <TextBlock x:Name="ToastTimeText"
                                           Text="09:00"
                                           Margin="8,0,0,0"
                                           FontFamily="{StaticResource AppFontFamily}"
                                           FontSize="10.5"
                                           Foreground="#FF8B949E"/>
                            </DockPanel>
                            <TextBlock x:Name="ToastTitleText"
                                       Text="Notification Title"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ToastBodyText"
                                       Text="Notification message body"
                                       Margin="0,1,0,0"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="11.5"
                                       Foreground="#FFD4D4D8"
                                       TextWrapping="Wrap"
                                       MaxHeight="34"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ToastAlarmActionButton"
                                    Visibility="Collapsed"
                                    Style="{StaticResource ShellIconButtonStyle}"
                                    Height="26"
                                    Padding="10,0"
                                    Margin="0,0,6,0"
                                    Background="#28F59E0B"
                                    BorderBrush="#55F59E0B"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Click="StopAlarmToast_Click"
                                    MouseRightButtonUp="OpenClockApp_RightClick"
                                    ToolTip="Click: Stop / Dismiss Alarm | Right-Click: Open Clock App">
                                <TextBlock Text="Stop Alarm"
                                           FontFamily="{StaticResource AppFontFamily}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFBBF24"
                                           VerticalAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource ShellIconButtonStyle}"
                                    Width="22"
                                    Height="22"
                                    Padding="5"
                                    VerticalAlignment="Center"
                                    Click="DismissToast_Click"
                                    ToolTip="Dismiss notification">
                                <Path Data="{StaticResource IconClose}"
                                      Stroke="{StaticResource SecondaryTextBrush}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- State D: Compact Expanded Hub View (530x148 layout + nixandock watermark) -->
                    <Grid x:Name="ExpandedHubView" Visibility="Collapsed" Margin="18,8,18,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header Row: Hub / Tray tabs on left, nixandock watermark + quick actions + gear on right -->
                        <DockPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton x:Name="HubTabButton"
                                              IsChecked="True"
                                              Style="{StaticResource HubTabButtonStyle}"
                                              Padding="9,3.5"
                                              Click="HubTabButton_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconSparkle}"
                                              Fill="{StaticResource PrimaryTextBrush}"
                                              Width="10"
                                              Height="10"
                                              Stretch="Uniform"
                                              Margin="0,0,5,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="Hub" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>

                                <ToggleButton x:Name="AlertsTabButton"
                                              IsChecked="False"
                                              Style="{StaticResource HubTabButtonStyle}"
                                              Padding="9,3.5"
                                              Margin="4,0,0,0"
                                              Click="AlertsTabButton_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconTray}"
                                              Stroke="{StaticResource PrimaryTextBrush}"
                                              StrokeThickness="1.35"
                                              Width="11"
                                              Height="10"
                                              Stretch="Uniform"
                                              Margin="0,0,5,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock x:Name="AlertsTabLabel" Text="Tray" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="nixandock"
                                           FontFamily="{StaticResource AppFontFamily}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#48FFFFFF"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>

                                <Button Style="{StaticResource ShellIconButtonStyle}"
                                        Width="22"
                                        Height="22"
                                        Padding="5"
                                        Margin="0,0,2,0"
                                        ToolTip="Night Light Settings"
                                        Click="QuickNightLight_Click">
                                    <Path Data="{StaticResource IconSun}"
                                          Stroke="{StaticResource SecondaryTextBrush}"
                                          StrokeThickness="1.4"
                                          Stretch="Uniform"/>
                                </Button>

                                <Button Style="{StaticResource ShellIconButtonStyle}"
                                        Width="22"
                                        Height="22"
                                        Padding="4.5"
                                        Margin="0,0,2,0"
                                        ToolTip="Mobile Hotspot (Right-click: Network Settings)"
                                        Click="QuickHotspot_Click"
                                        MouseRightButtonUp="TopWifi_RightClick">
                                    <Path Data="{StaticResource IconHotspot}"
                                          Stroke="{StaticResource SecondaryTextBrush}"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Stretch="Uniform"/>
                                </Button>

                                <Button Style="{StaticResource ShellIconButtonStyle}"
                                        Width="22"
                                        Height="22"
                                        Padding="5"
                                        Margin="0,0,2,0"
                                        ToolTip="Lock PC (Win+L)"
                                        Click="QuickLockScreen_Click">
                                    <Path Data="{StaticResource IconLock}"
                                          Stroke="{StaticResource SecondaryTextBrush}"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Stretch="Uniform"/>
                                </Button>

                                <Button Style="{StaticResource ShellIconButtonStyle}"
                                        Width="22"
                                        Height="22"
                                        Padding="4.5"
                                        ToolTip="Windows Settings"
                                        Click="ShortcutSettings_Click">
                                    <Path Data="{StaticResource IconSettings}"
                                          Stroke="{StaticResource PrimaryTextBrush}"
                                          StrokeThickness="1.35"
                                          Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <!-- Tab 1: Hub (Clean 2-column functional Control Hub: Media Player + Quick Controls) -->
                        <Grid x:Name="ControlCenterPanel" Grid.Row="2" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="232"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: Media Player Card -->
                            <Border Grid.Column="0"
                                    Background="#10FFFFFF"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="10,8">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="60" Height="60">
                                        <Border Width="60"
                                                Height="60"
                                                CornerRadius="12"
                                                Background="#1BFFFFFF"
                                                ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="♫"
                                                           FontSize="19"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <Image x:Name="ExpandedAlbumArt"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Clip>
                                                        <RectangleGeometry RadiusX="12" RadiusY="12" Rect="0,0,60,60"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Grid>
                                        </Border>

                                        <Border Width="19"
                                                Height="19"
                                                CornerRadius="9.5"
                                                Background="#FF1DB954"
                                                BorderBrush="#FF000000"
                                                BorderThickness="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,-3,-3">
                                            <Path Data="{StaticResource IconMusicNote}"
                                                  Fill="White"
                                                  Width="8.5"
                                                  Height="8.5"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="10,0,2,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="ExpandedTrackTitle"
                                                   Text="No Media Playing"
                                                   FontFamily="{StaticResource AppFontFamily}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="ExpandedTrackArtist"
                                                   Text="Ready for SMTC"
                                                   Margin="0,1,0,6"
                                                   FontFamily="{StaticResource AppFontFamily}"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="-4,0,0,0">
                                            <Button Style="{StaticResource ShellIconButtonStyle}" Width="24" Height="24" Padding="5" Click="PrevMedia_Click" ToolTip="Previous / Rewind">
                                                <Path Data="{StaticResource IconPrev}" Fill="{StaticResource PrimaryTextBrush}" Stretch="Uniform"/>
                                            </Button>
                                            <Button Style="{StaticResource ShellIconButtonStyle}" Width="26" Height="24" Padding="5" Margin="2,0" Click="PlayPauseMedia_Click" ToolTip="Play / Pause">
                                                <Path x:Name="PlayPauseIconPath" Data="{StaticResource IconPlay}" Fill="{StaticResource PrimaryTextBrush}" Stretch="Uniform"/>
                                            </Button>
                                            <Button Style="{StaticResource ShellIconButtonStyle}" Width="24" Height="24" Padding="5" Click="NextMedia_Click" ToolTip="Next / Forward">
                                                <Path Data="{StaticResource IconNext}" Fill="{StaticResource PrimaryTextBrush}" Stretch="Uniform"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Column 1: Functional Quick Controls Card (Uniform Rounded-Square Tiles) -->
                            <Border Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Background="#10FFFFFF"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="6,6">
                                <UniformGrid Columns="4" VerticalAlignment="Center">
                                    <Button x:Name="QuickDndButton"
                                            Style="{StaticResource RoundedTileButtonStyle}"
                                            Height="66"
                                            Margin="3,0"
                                            Click="QuickDnd_Click"
                                            MouseRightButtonUp="QuickDnd_RightClick"
                                            ToolTip="Click: Toggle Do Not Disturb (DND) | Right-Click: DND Settings">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path x:Name="QuickDndIcon"
                                                  Data="{StaticResource IconMoon}"
                                                  Fill="{StaticResource PrimaryTextBrush}"
                                                  StrokeThickness="0"
                                                  Width="15"
                                                  Height="15"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="QuickDndText"
                                                       Text="DND"
                                                       Margin="0,5,0,0"
                                                       FontFamily="{StaticResource AppFontFamily}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource RoundedTileButtonStyle}"
                                            Height="66"
                                            Margin="3,0"
                                            Click="QuickProject_Click"
                                            MouseRightButtonUp="QuickProject_RightClick"
                                            ToolTip="Screen Mirror / Project (Right-Click: Display Settings)">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconMirror}"
                                                  Stroke="{StaticResource PrimaryTextBrush}"
                                                  StrokeThickness="1.4"
                                                  Width="15"
                                                  Height="15"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"/>
                                            <TextBlock Text="Mirror"
                                                       Margin="0,5,0,0"
                                                       FontFamily="{StaticResource AppFontFamily}"
                                                       FontSize="10"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="QuickBluetoothButton"
                                            Style="{StaticResource RoundedTileButtonStyle}"
                                            Height="66"
                                            Margin="3,0"
                                            Click="QuickBluetooth_Click"
                                            MouseRightButtonUp="QuickBluetooth_RightClick"
                                            ToolTip="Click: Toggle Bluetooth On/Off | Right-Click: Bluetooth Settings">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path x:Name="QuickBluetoothIcon"
                                                  Data="{StaticResource IconBluetooth}"
                                                  Stroke="{StaticResource PrimaryTextBrush}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Width="15"
                                                  Height="15"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="QuickBluetoothText"
                                                       Text="Bluetooth"
                                                       Margin="0,5,0,0"
                                                       FontFamily="{StaticResource AppFontFamily}"
                                                       FontSize="9.5"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource RoundedTileButtonStyle}"
                                            Height="66"
                                            Margin="3,0"
                                            Click="QuickSnip_Click"
                                            MouseRightButtonUp="QuickSnip_RightClick"
                                            ToolTip="Click: Screen Snip | Right-Click: Snipping Tool">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconSnip}"
                                                  Stroke="{StaticResource PrimaryTextBrush}"
                                                  StrokeThickness="1.4"
                                                  Width="15"
                                                  Height="15"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"/>
                                            <TextBlock Text="Snip"
                                                       Margin="0,5,0,0"
                                                       FontFamily="{StaticResource AppFontFamily}"
                                                       FontSize="10"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </Border>
                        </Grid>

                        <!-- Tab 2: Rich Notification History Drawer (Tray — Dynamic Island auto-expands vertically when active) -->
                        <Border x:Name="NotificationDrawerPanel"
                                Grid.Row="2"
                                Visibility="Collapsed"
                                Background="#10FFFFFF"
                                BorderBrush="#1AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12,9">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,7">
                                    <TextBlock Text="Recent Notifications"
                                               FontFamily="{StaticResource AppFontFamily}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Test"
                                                Style="{StaticResource ShellIconButtonStyle}"
                                                Padding="8,2"
                                                FontSize="10.5"
                                                Margin="0,0,4,0"
                                                Click="TestNotification_Click"/>
                                        <Button Content="Clear All"
                                                Style="{StaticResource ShellIconButtonStyle}"
                                                Padding="8,2"
                                                FontSize="10.5"
                                                Click="ClearNotifications_Click"/>
                                    </StackPanel>
                                </DockPanel>

                                <Grid Grid.Row="1">
                                    <TextBlock x:Name="NotificationEmptyText"
                                               Text="No recent notifications."
                                               FontFamily="{StaticResource AppFontFamily}"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>

                                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="NotificationHistoryList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="10"
                                                            Padding="9,6"
                                                            Margin="0,0,0,5"
                                                            BorderThickness="1"
                                                            Cursor="Hand"
                                                            Tag="{Binding}"
                                                            MouseLeftButtonUp="NotificationItem_Click"
                                                            ToolTip="Click to open app">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#14FFFFFF"/>
                                                                <Setter Property="BorderBrush" Value="#16FFFFFF"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#24FFFFFF"/>
                                                                        <Setter Property="BorderBrush" Value="#34FFFFFF"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Background="#1BFFFFFF" ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,9,0">
                                                                <Grid>
                                                                    <Path x:Name="ItemFallbackBell" Data="{StaticResource IconBell}" Visibility="Collapsed" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <Image Source="{Binding AppIcon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                                                        <Image.Clip>
                                                                            <RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,28,28"/>
                                                                        </Image.Clip>
                                                                    </Image>
                                                                </Grid>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding AppName}"
                                                                               FontFamily="{StaticResource AppFontFamily}"
                                                                               FontSize="9.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#FF8B949E"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontFamily="{StaticResource AppFontFamily}"
                                                                           FontSize="11.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Body}"
                                                                           FontFamily="{StaticResource AppFontFamily}"
                                                                           FontSize="10.5"
                                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding TimeText}"
                                                                       FontFamily="{StaticResource AppFontFamily}"
                                                                       FontSize="10"
                                                                       Foreground="#FF8B949E"
                                                                       VerticalAlignment="Top"
                                                                       Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding AppIcon}" Value="{x:Null}">
                                                            <Setter TargetName="ItemFallbackBell" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                </Grid>
            </Grid>
            </Grid>
        </Border>

        <!-- 3. WINDOWS-STYLE SYSTEM TRAY OVERFLOW DROPDOWN (Toggled by TopTrayDropdownButton) -->
        <Border x:Name="TrayPopupShell"
                MinWidth="156"
                MaxWidth="216"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,34,195,0"
                Visibility="Collapsed"
                Background="{StaticResource PopupGlassBackgroundBrush}"
                BorderBrush="{StaticResource PopupGlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="8"
                Effect="{StaticResource NotchShadowEffect}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="TrayPopupSlideTransform" Y="-8"/>
            </Border.RenderTransform>

            <ItemsControl x:Name="TrayIconsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="36"
                                Height="36"
                                Margin="2"
                                CornerRadius="8"
                                Background="Transparent"
                                Cursor="Hand"
                                Tag="{Binding}"
                                ToolTip="{Binding Title}"
                                MouseEnter="TrayIcon_MouseEnter"
                                MouseLeave="TrayIcon_MouseLeave"
                                MouseDown="TrayIcon_MouseDown"
                                MouseUp="TrayIcon_MouseUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource HoverSurfaceBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Image Source="{Binding Icon}"
                                   Width="18"
                                   Height="18"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- 4. DEDICATED VOLUME SLIDER POPOVER (Toggled exclusively by Volume button) -->
        <Border x:Name="VolumePopupShell"
                Width="236"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,34,50,0"
                Visibility="Collapsed"
                Background="{StaticResource PopupGlassBackgroundBrush}"
                BorderBrush="{StaticResource PopupGlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12,10"
                Effect="{StaticResource NotchShadowEffect}"
                PreviewMouseWheel="VolumePopup_MouseWheel">
            <Border.RenderTransform>
                <TranslateTransform x:Name="VolumePopupSlideTransform" Y="-8"/>
            </Border.RenderTransform>

            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <Button Style="{StaticResource ShellIconButtonStyle}"
                            Width="24"
                            Height="22"
                            Padding="4"
                            Click="MuteButton_Click"
                            DockPanel.Dock="Left"
                            ToolTip="Toggle Mute">
                        <Path x:Name="PopupMuteIconPath"
                              Data="{StaticResource IconSpeaker}"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform"/>
                    </Button>
                    <TextBlock Text="Volume"
                               Margin="6,0,0,0"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="PopupVolumePercentText"
                               Text="50%"
                               HorizontalAlignment="Right"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="11.5"
                               FontWeight="Medium"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <Slider x:Name="PopupVolumeSlider"
                        Style="{StaticResource ModernVolumeSliderStyle}"
                        Value="50"
                        ValueChanged="VolumeSlider_ValueChanged"/>
            </StackPanel>
        </Border>

        <!-- 5. DEDICATED BRIGHTNESS SLIDER POPOVER (Toggled exclusively by Brightness button) -->
        <Border x:Name="BrightnessPopupShell"
                Width="236"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,34,95,0"
                Visibility="Collapsed"
                Background="{StaticResource PopupGlassBackgroundBrush}"
                BorderBrush="{StaticResource PopupGlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12,10"
                Effect="{StaticResource NotchShadowEffect}"
                PreviewMouseWheel="BrightnessPopup_MouseWheel">
            <Border.RenderTransform>
                <TranslateTransform x:Name="BrightnessPopupSlideTransform" Y="-8"/>
            </Border.RenderTransform>

            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <Path Data="{StaticResource IconSun}"
                          Stroke="{StaticResource PrimaryTextBrush}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Width="14"
                          Height="14"
                          Stretch="Uniform"
                          DockPanel.Dock="Left"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="Brightness"
                               Margin="8,0,0,0"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="PopupBrightnessPercentText"
                               Text="80%"
                               HorizontalAlignment="Right"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="11.5"
                               FontWeight="Medium"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <Slider x:Name="PopupBrightnessSlider"
                        Style="{StaticResource ModernVolumeSliderStyle}"
                        Minimum="5"
                        Maximum="100"
                        Value="80"
                        ValueChanged="BrightnessSlider_ValueChanged"/>
            </StackPanel>
        </Border>

        <!-- 6. WINDOWS-STYLE CLOCK CALENDAR & NOTIFICATION FLYOUT (Toggled by ClockHubButton) -->
        <Border x:Name="ClockCalendarPopupShell"
                Width="324"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,34,10,0"
                Visibility="Collapsed"
                Opacity="0"
                Background="{StaticResource PopupGlassBackgroundBrush}"
                BorderBrush="{StaticResource PopupGlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="14,10"
                Effect="{StaticResource NotchShadowEffect}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ClockPopupSlideTransform" Y="-8"/>
            </Border.RenderTransform>
            <StackPanel>
                <!-- Today Full Date Header + Clock App Settings Button -->
                <DockPanel Margin="0,0,0,6">
                    <Button Style="{StaticResource ShellIconButtonStyle}"
                            HorizontalAlignment="Left"
                            Padding="4,2"
                            Margin="-4,0,0,0"
                            Click="CalendarTodayHeader_Click"
                            ToolTip="Jump to today">
                        <TextBlock x:Name="CalendarTodayHeaderText"
                                   Text="Friday, 13 November 2026"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Button>

                    <Button Style="{StaticResource ShellIconButtonStyle}"
                            HorizontalAlignment="Right"
                            Padding="7,3"
                            Click="OpenClockSettings_Click"
                            ToolTip="Open Windows Clock &amp; Alarms">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSettings}"
                                  Stroke="{StaticResource SecondaryTextBrush}"
                                  StrokeThickness="1.4"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Clock"
                                       Margin="5,0,0,0"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="10.5"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <!-- Month & Year Navigation Bar -->
                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="CalendarMonthYearText"
                               Text="November 2026"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ShellIconButtonStyle}"
                                Width="24"
                                Height="24"
                                Margin="0,0,4,0"
                                Click="CalendarPrevMonth_Click"
                                ToolTip="Previous Month">
                            <TextBlock Text="‹"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Margin="0,-2,0,0"/>
                        </Button>
                        <Button Style="{StaticResource ShellIconButtonStyle}"
                                Width="24"
                                Height="24"
                                Click="CalendarNextMonth_Click"
                                ToolTip="Next Month">
                            <TextBlock Text="›"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Margin="0,-2,0,0"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Weekday Labels (Mon-Sun) -->
                <UniformGrid Columns="7" Margin="0,0,0,4">
                    <TextBlock Text="Mo" HorizontalAlignment="Center" FontFamily="{StaticResource AppFontFamily}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF8B949E"/>
                    <TextBlock Text="Tu" HorizontalAlignment="Center" FontFamily="{StaticResource AppFontFamily}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF8B949E"/>
                    <TextBlock Text="We" HorizontalAlignment="Center" FontFamily="{StaticResource AppFontFamily}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF8B949E"/>
                    <TextBlock Text="Th" HorizontalAlignment="Center" FontFamily="{StaticResource AppFontFamily}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF8B949E"/>
                    <TextBlock Text="Fr" HorizontalAlignment="Center" FontFamily="{StaticResource AppFontFamily}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF8B949E"/>
                    <TextBlock Text="Sa" HorizontalAlignment="Center" FontFamily="{StaticResource AppFontFamily}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF8B949E"/>
                    <TextBlock Text="Su" HorizontalAlignment="Center" FontFamily="{StaticResource AppFontFamily}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF8B949E"/>
                </UniformGrid>

                <!-- Monthly Calendar Days Grid (42 cells populated dynamically) -->
                <UniformGrid x:Name="MonthCalendarGrid" Columns="7" Rows="6" Height="162"/>

                <Border Height="1" Background="#1EFFFFFF" Margin="0,10"/>

                <!-- Notifications List Section -->
                <DockPanel Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Notifications"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                        <Border Background="#20FFFFFF" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ClockNotifCountBadge"
                                       Text="0"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                        </Border>
                    </StackPanel>

                    <Button Content="Clear All"
                            HorizontalAlignment="Right"
                            Style="{StaticResource ShellIconButtonStyle}"
                            Padding="8,2"
                            FontSize="10.5"
                            Click="ClearNotifications_Click"/>
                </DockPanel>

                <Grid Height="175">
                    <TextBlock x:Name="ClockNotificationEmptyText"
                               Text="No notifications"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>

                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ClockNotificationList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10"
                                            Padding="8,6"
                                            Margin="0,0,0,5"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            Tag="{Binding}"
                                            MouseLeftButtonUp="NotificationItem_Click"
                                            ToolTip="Click to open app">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#12FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#16FFFFFF"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#24FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="#34FFFFFF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7" Background="#1BFFFFFF" ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Grid>
                                                    <Path x:Name="ClockItemFallbackBell" Data="{StaticResource IconBell}" Visibility="Collapsed" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding AppIcon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Clip>
                                                            <RectangleGeometry RadiusX="7" RadiusY="7" Rect="0,0,26,26"/>
                                                        </Image.Clip>
                                                    </Image>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AppName}"
                                                           FontFamily="{StaticResource AppFontFamily}"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FF8B949E"/>
                                                <TextBlock Text="{Binding Title}"
                                                           FontFamily="{StaticResource AppFontFamily}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Body}"
                                                           FontFamily="{StaticResource AppFontFamily}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TimeText}"
                                                       FontFamily="{StaticResource AppFontFamily}"
                                                       FontSize="9.5"
                                                       Foreground="#FF8B949E"
                                                       VerticalAlignment="Top"
                                                       Margin="6,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding AppIcon}" Value="{x:Null}">
                                            <Setter TargetName="ClockItemFallbackBell" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
